# ─────────────────────────────────────────────────────────────────────────────
# Variables del SERVIDOR LOCAL de una tienda (modo híbrido, docs/MODO_HIBRIDO.md).
# Copiar como .env junto al backend del nodo y completar.
# ─────────────────────────────────────────────────────────────────────────────

# Base propia del nodo (Postgres instalado en el equipo de la tienda).
# El usuario debe ser superusuario: la réplica del catálogo apaga llaves y
# triggers mientras aplica (session_replication_role).
DB_URL=jdbc:postgresql://localhost:5432/aura_nodo
DB_USER=postgres
DB_PASSWORD=

SERVER_PORT=9001
FRONTEND_URL=http://localhost:4200

# Llaves propias del nodo (no hace falta que sean las de la nube).
JWT_SECRET=
AES_KEY=

# El nodo no habla con Factus (lo hace la nube), pero la propiedad es obligatoria.
FACTUS_API_BASE_URL=https://api.factus.com.co

# ── Modo híbrido ─────────────────────────────────────────────────────────────
APP_SYNC_MODO=LOCAL
# URL de la nube, sin barra final.
APP_SYNC_NUBE_URL=https://api.tudominio.com
# Token que mostró la nube al registrar el nodo (POST /api/sync/nodos).
APP_SYNC_NODO_TOKEN=
# Subir la cola cada 15 s; bajar catálogo y existencias cada 5 min.
APP_SYNC_INTERVALO_MS=15000
APP_SYNC_CATALOGO_CADA_MS=300000
